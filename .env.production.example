# =============================================================
# 365 (Memory Bank) — Production Environment Variables
# =============================================================

# Application Settings
ENVIRONMENT=production
DEBUG=False
PORT=80
PROJECT_NAME="365 Journal API"

# Database Configuration (PostgreSQL)
POSTGRES_USER=memory_user
POSTGRES_PASSWORD=generate_a_strong_password_here
POSTGRES_DB=memory_bank
DATABASE_URL=postgresql://memory_user:generate_a_strong_password_here@db:5432/memory_bank

# Security & Authentication (JWT)
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=30

# Optional: Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Daily Question Generation (Anthropic Claude API)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Object Storage for Photos & Voice Notes (AWS S3 or Cloudflare R2)
# If empty, media falls back safely to the local /app/uploads persistent volume.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=memory-bank-media
S3_REGION_NAME=us-east-1
S3_USER_ARN=

# Push Notifications (Firebase Cloud Messaging / Web Push)
FIREBASE_CREDENTIALS_PATH=
